---
import { formatPrice } from '../utils/price';

interface Props {
  slug: string;
  title: string;
  summary?: string;
  condition?: string;
  price?: number;
  priceNote?: string;
  image?: string;
}

const { slug, title, summary, condition, price, priceNote, image } = Astro.props;
---

<a href={`/for-sale/${slug}/`} class="block group h-full">
  <article class="chip h-full bg-bg-secondary overflow-hidden flex flex-col">
    <div class="aspect-4/3 bg-bg-tertiary overflow-hidden">
      {image ? (
        <img
          src={image}
          alt={title}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-105"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-text-secondary text-sm">No photos yet</div>
      )}
    </div>

    <div class="p-4 flex flex-col flex-1">
      <h3 class="display text-text-primary group-hover:text-accent transition-colors">{title}</h3>
      {condition && <p class="text-xs text-text-secondary mt-1">{condition}</p>}
      {summary && <p class="text-sm text-text-secondary mt-2 leading-relaxed line-clamp-3">{summary}</p>}
      <p class="mt-auto pt-3 flex items-baseline flex-wrap gap-x-2">
        {price != null ? (
          <>
            <span class="meta text-lg font-medium text-accent">{formatPrice(price)}</span>
            {priceNote && <span class="text-xs text-text-secondary">{priceNote}</span>}
          </>
        ) : (
          <span class="meta text-base text-accent">{priceNote || 'Make an offer'}</span>
        )}
      </p>
    </div>
  </article>
</a>
