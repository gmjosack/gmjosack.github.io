---
import type { Project } from '../data/projects';
import { platformMeta, platformOrder } from '../data/projects';
import Icon from './Icon.astro';

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const primary = project.primaryLink || (project.itchUrl ? 'itch' : project.steamUrl ? 'steam' : project.githubUrl ? 'github' : 'url');

// Credit blurbs are dense with links — six or seven per card. At full accent
// strength they out-shouted the card's own actions, so they stay in the body
// color with an underline and only pick up the accent on hover.
function inlineMarkdown(text: string): string {
  return text
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2" target="_blank" rel="noopener noreferrer" class="underline decoration-text-secondary/40 underline-offset-2 hover:text-accent hover:decoration-accent transition-colors">$1</a>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
    .replace(/\*([^*]+)\*/g, '<em>$1</em>');
}

const contextHtml = project.context ? inlineMarkdown(project.context) : '';

/* Facts pulled out of the prose so they can be scanned and compared across the
   grid: engine, when, which jam. `status` stands in for a year on work that
   hasn't shipped, so nothing in flight gets stamped with a launch date.
   Collaborators deliberately stay in the prose, not here. */
type Stat = { label: string; href?: string };
const stats: Stat[] = [
  project.engine ? { label: project.engine } : null,
  project.year ? { label: String(project.year) } : null,
  project.status ? { label: project.status } : null,
  project.jam ? { label: project.jam.name, href: project.jam.url } : null,
].filter((s): s is Stat => s !== null);

/* Sorted into a fixed order so the same combination always looks the same from
   card to card — otherwise the eye can't compare them down the grid. */
const platforms = platformOrder
  .filter((p) => project.platforms?.includes(p))
  .map((p) => ({ ...platformMeta[p], key: p }));

type LinkEntry = { href: string; label: string; key: string };
const links: LinkEntry[] = [
  project.itchUrl ? { href: project.itchUrl, label: 'itch.io', key: 'itch' } : null,
  project.steamUrl ? { href: project.steamUrl, label: 'Steam', key: 'steam' } : null,
  project.githubUrl ? { href: project.githubUrl, label: 'GitHub', key: 'github' } : null,
  project.url ? { href: project.url, label: project.urlLabel || 'Website', key: 'url' } : null,
].filter((l): l is LinkEntry => l !== null)
 .sort((a, b) => (a.key === primary ? -1 : b.key === primary ? 1 : 0));
---

<div class:list={[
  "chip bg-bg-secondary overflow-hidden h-full",
  featured && "chip--featured",
  project.image ? "flex flex-col sm:flex-row" : "flex flex-col",
]}>
  {project.image && (
    <div class:list={[
      "shrink-0 relative overflow-hidden flex items-center",
      featured ? "w-full sm:w-72" : "w-full sm:w-48",
    ]}>
      <div
        class="absolute inset-0 scale-125 blur-xl bg-cover bg-center opacity-50"
        style={`background-image: url('${project.image}');`}
      />
      <img
        src={project.image}
        alt={project.name}
        class="w-full object-cover relative z-10"
      />
    </div>
  )}
  <div class="flex flex-col flex-1">
    {/* Top-aligned, not centered. Grid rows stretch every card to the tallest
        in the row, so centering pushed the title of a short card halfway down
        and left titles sitting at different heights across a row. */}
    <div class:list={["flex flex-col flex-1", featured ? "px-6 py-5" : "px-5 py-4"]}>
      {/* Platforms ride the title rather than the stat line: they answer "can I
          run this", which is a different question from engine/year/jam and
          doesn't belong in the same slash-separated run. */}
      <div class="flex items-center justify-between gap-3 mb-1">
        <h3 class:list={["display text-text-primary", featured ? "text-3xl" : "text-xl"]}>{project.name}</h3>
        {platforms.length > 0 && (
          <span
            class="flex items-center gap-1.5 shrink-0 text-text-secondary/70"
            role="img"
            aria-label={`Runs on ${platforms.map((p) => p.label).join(', ')}`}
          >
            {platforms.map((p) => (
              <Icon name={p.icon} class={featured ? 'w-4 h-4' : 'w-3.5 h-3.5'} />
            ))}
          </span>
        )}
      </div>
      <p class:list={["text-text-secondary", featured ? "text-base" : "text-sm"]}>{project.description}</p>

      {stats.length > 0 && (
        <div class="stat-strip mt-2.5 pt-2">
          <p class="meta flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-text-secondary">
            {stats.map((stat, i) => (
              <>
                {i > 0 && <span class="text-text-secondary/35" aria-hidden="true">/</span>}
                {stat.href ? (
                  <a
                    href={stat.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-accent transition-colors"
                  >
                    {stat.label}
                  </a>
                ) : (
                  <span>{stat.label}</span>
                )}
              </>
            ))}
          </p>
        </div>
      )}

      {contextHtml && <p class="text-text-secondary/70 text-xs mt-2.5 italic"><Fragment set:html={contextHtml} /></p>}
    </div>
    {links.length > 0 && (
      <div class="flex border-t border-bg-tertiary">
        {links.map((link) => (
          <a
            href={link.href}
            target="_blank"
            rel="noopener noreferrer"
            class:list={[
              "meta flex-1 text-center text-xs py-2 transition-colors border-r border-bg-tertiary last:border-r-0",
              link.key === primary
                ? "text-accent hover:bg-accent/10"
                : "text-text-secondary hover:text-text-primary hover:bg-bg-tertiary",
            ]}
          >
            {link.label}
          </a>
        ))}
      </div>
    )}
  </div>
</div>

<style>
  /* A hairline above the strip separates fact from story without boxing it in.
     It sits inside the card's padding, so it reads as a rule under the
     description rather than as a full-width divider like the link row's. */
  .stat-strip {
    border-top: 1px solid var(--color-bg-tertiary);
  }
</style>
