---
/* Brand and utility marks, kept in one place so a logo path is never pasted
   into a component again. Everything is `currentColor`, so callers set the
   color and size with utility classes.

   Purely decorative here — each icon is aria-hidden, and the anchor that wraps
   it carries the accessible name. */
interface Props {
  name:
    | 'github' | 'itchio' | 'steam' | 'bluesky' | 'discord'
    // `globe` does double duty: a project's website in the software list,
    // and "runs in a browser" in a game's platform row. Context separates them.
    | 'globe' | 'windows' | 'apple' | 'linux';
  class?: string;
}

const { name, class: className = 'w-5 h-5' } = Astro.props;
