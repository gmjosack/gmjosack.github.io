---
import { getCollection } from 'astro:content';
import { buildTagColors } from '../utils/tag-colors';

interface Props {
  tag: string;
  linked?: boolean;
}

const { tag, linked = false } = Astro.props;

const posts = await getCollection('posts');
const allTags = [...new Set(posts.flatMap(p => p.data.tags))];
const colorMap = buildTagColors(allTags);
const hs = colorMap.get(tag) ?? '0 0%';

const classes = "chip chip--xs meta inline-block px-2.5 py-0.5 text-xs";
---

{linked ? (
  <a href={`/posts/?tag=${tag}`} class={classes} style={`--tag-hs: ${hs};`}>{tag}</a>
) : (
  <span class={classes} style={`--tag-hs: ${hs};`}>{tag}</span>
)}

<style>
  /* Tags keep their own generated hue instead of the accent, so the chip's
     stroke variables are overridden rather than inherited. */
  a, span {
    --chip-stroke: hsl(var(--tag-hs) 50% / 0.3);
    --chip-stroke-hover: hsl(var(--tag-hs) 50% / 0.55);
    background: hsl(var(--tag-hs) 50% / 0.12);
    color: hsl(var(--tag-hs) 75%);
    transition: background 150ms, box-shadow 150ms;
  }
  a:hover {
    background: hsl(var(--tag-hs) 50% / 0.22);
  }
</style>
