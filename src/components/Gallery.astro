---
/**
 * Thumbnail grid plus a zoomable fullscreen lightbox.
 *
 * Lightbox controls: click or arrow keys to move between photos, click the
 * photo (or scroll / pinch) to zoom, drag to pan, Esc or a click outside to
 * close, 0 to reset the zoom.
 */
interface GalleryImage {
  src: string;
  alt?: string;
  caption?: string;
}

interface Props {
  images: GalleryImage[];
  title: string;
}

const { images, title } = Astro.props;
const items = images.map((img, i) => ({
  src: img.src,
  alt: img.alt || `${title} - photo ${i + 1}`,
  caption: img.caption || '',
}));
---

{items.length > 0 && (
  <>
    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
      {items.map((img, i) => (
        <button
          type="button"
          data-lb-index={i}
          class="chip chip--sm chip--flat group relative block aspect-square overflow-hidden bg-bg-secondary cursor-zoom-in"
          aria-label={`Open photo ${i + 1} of ${items.length}`}
        >
          <img
            src={img.src}
            alt={img.alt}
            loading={i < 6 ? 'eager' : 'lazy'}
            class="w-full h-full object-cover transition-transform duration-200 group-hover:scale-105"
          />
          <span class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors" />
        </button>
      ))}
    </div>

    <p class="mt-2 text-xs text-text-secondary">
      Click a photo to open it full screen, then click again (or scroll / pinch) to zoom in.
    </p>

    <div
      id="lb"
      class="fixed inset-0 z-50 hidden bg-black/95 select-none"
      role="dialog"
      aria-modal="true"
      aria-hidden="true"
      aria-label={`${title} photos`}
    >
      <div id="lb-stage" class="absolute inset-0 flex items-center justify-center overflow-hidden touch-none">
        <img id="lb-img" class="max-w-full max-h-full object-contain will-change-transform" alt="" />
      </div>

      <div class="pointer-events-none absolute top-0 inset-x-0 flex items-center justify-between gap-4 p-4 z-10 bg-gradient-to-b from-black/70 to-transparent">
        <span id="lb-counter" class="text-sm text-text-secondary tabular-nums" />
        <div class="pointer-events-auto flex items-center gap-2">
          <button id="lb-zoom" type="button" class="lb-btn" aria-label="Toggle zoom">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <circle cx="11" cy="11" r="7" /><path d="M21 21l-4.3-4.3M11 8v6M8 11h6" stroke-linecap="round" />
            </svg>
          </button>
          <button id="lb-close" type="button" class="lb-btn" aria-label="Close">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" />
            </svg>
          </button>
        </div>
      </div>

      {items.length > 1 && (
        <>
          <button id="lb-prev" type="button" class="lb-btn lb-nav left-2" aria-label="Previous photo">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M15 5l-7 7 7 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button id="lb-next" type="button" class="lb-btn lb-nav right-2" aria-label="Next photo">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
              <path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </>
      )}

      <div
        id="lb-caption"
        class="pointer-events-none absolute bottom-0 inset-x-0 p-4 pb-6 text-center text-sm text-text-primary bg-gradient-to-t from-black/80 to-transparent empty:hidden"
      />
    </div>

    <script is:inline define:vars={{ items }}>
      (function () {
        if (!items.length) return;

        const lb = document.getElementById('lb');
        const stage = document.getElementById('lb-stage');
        const el = document.getElementById('lb-img');
        const counter = document.getElementById('lb-counter');
        const caption = document.getElementById('lb-caption');

        const MIN = 1;
        const MAX = 6;
        const DOUBLE = 2.5;

        let idx = 0;
        let scale = MIN;
        let tx = 0;
        let ty = 0;
        let lastFocus = null;

        function apply() {
          el.style.transform = 'translate(' + tx + 'px, ' + ty + 'px) scale(' + scale + ')';
          el.style.cursor = scale > MIN ? 'grab' : 'zoom-in';
        }

        // Keep the scaled image from being dragged completely off screen.
        function clamp() {
          const maxX = Math.max(0, (el.clientWidth * scale - stage.clientWidth) / 2);
          const maxY = Math.max(0, (el.clientHeight * scale - stage.clientHeight) / 2);
          tx = Math.min(maxX, Math.max(-maxX, tx));
          ty = Math.min(maxY, Math.max(-maxY, ty));
        }

        // Zoom to `target`, holding the point under (cx, cy) in place.
        function zoomAt(cx, cy, target) {
          target = Math.min(MAX, Math.max(MIN, target));
          const r = stage.getBoundingClientRect();
          const centerX = r.left + r.width / 2;
          const centerY = r.top + r.height / 2;
          const px = (cx - centerX - tx) / scale;
          const py = (cy - centerY - ty) / scale;
          tx += px * (scale - target);
          ty += py * (scale - target);
          scale = target;
          if (scale === MIN) {
            tx = 0;
            ty = 0;
          }
          clamp();
          apply();
        }

        function reset() {
          scale = MIN;
          tx = 0;
          ty = 0;
          apply();
        }

        function show(i) {
          idx = (i + items.length) % items.length;
          const d = items[idx];
          el.src = d.src;
          el.alt = d.alt;
          counter.textContent = items.length > 1 ? idx + 1 + ' / ' + items.length : '';
          caption.textContent = d.caption;
          reset();
          // Warm the neighbours so navigation feels instant.
          [idx + 1, idx - 1].forEach(function (n) {
            const next = items[(n + items.length) % items.length];
            if (next) new Image().src = next.src;
          });
        }

        function open(i) {
          lastFocus = document.activeElement;
          show(i);
          lb.classList.remove('hidden');
          lb.setAttribute('aria-hidden', 'false');
          document.body.style.overflow = 'hidden';
          document.getElementById('lb-close').focus();
        }

        function close() {
          lb.classList.add('hidden');
          lb.setAttribute('aria-hidden', 'true');
          document.body.style.overflow = '';
          if (lastFocus && lastFocus.focus) lastFocus.focus();
        }

        function isOpen() {
          return !lb.classList.contains('hidden');
        }

        document.querySelectorAll('[data-lb-index]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            open(Number(btn.dataset.lbIndex));
          });
        });

        document.getElementById('lb-close').addEventListener('click', close);
        document.getElementById('lb-zoom').addEventListener('click', function () {
          const r = stage.getBoundingClientRect();
          zoomAt(r.left + r.width / 2, r.top + r.height / 2, scale > MIN ? MIN : DOUBLE);
        });

        const prev = document.getElementById('lb-prev');
        const next = document.getElementById('lb-next');
        if (prev) prev.addEventListener('click', function () { show(idx - 1); });
        if (next) next.addEventListener('click', function () { show(idx + 1); });

        document.addEventListener('keydown', function (e) {
          if (!isOpen()) return;
          if (e.key === 'Escape') close();
          else if (e.key === 'ArrowLeft') show(idx - 1);
          else if (e.key === 'ArrowRight') show(idx + 1);
          else if (e.key === '0') reset();
          else return;
          e.preventDefault();
        });

        stage.addEventListener('wheel', function (e) {
          e.preventDefault();
          zoomAt(e.clientX, e.clientY, scale * Math.exp(-e.deltaY * 0.002));
        }, { passive: false });

        // Pointer handling: drag to pan when zoomed, swipe to navigate when
        // not, two fingers to pinch.
        const pointers = new Map();
        let pinchDist = 0;
        let pinchScale = 1;
        let lastX = 0;
        let lastY = 0;
        let downX = 0;
        let downY = 0;
        let moved = false;

        stage.addEventListener('pointerdown', function (e) {
          pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
          stage.setPointerCapture(e.pointerId);
          moved = false;
          downX = lastX = e.clientX;
          downY = lastY = e.clientY;
          if (pointers.size === 2) {
            const p = Array.from(pointers.values());
            pinchDist = Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y);
            pinchScale = scale;
          }
        });

        stage.addEventListener('pointermove', function (e) {
          if (!pointers.has(e.pointerId)) return;
          pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

          if (pointers.size === 2) {
            const p = Array.from(pointers.values());
            const dist = Math.hypot(p[0].x - p[1].x, p[0].y - p[1].y);
            if (pinchDist > 0) {
              zoomAt((p[0].x + p[1].x) / 2, (p[0].y + p[1].y) / 2, pinchScale * (dist / pinchDist));
            }
            moved = true;
            return;
          }

          const dx = e.clientX - lastX;
          const dy = e.clientY - lastY;
          lastX = e.clientX;
          lastY = e.clientY;
          if (Math.abs(e.clientX - downX) > 6 || Math.abs(e.clientY - downY) > 6) moved = true;
          if (scale > MIN) {
            tx += dx;
            ty += dy;
            clamp();
            apply();
          }
        });

        function endPointer(e) {
          if (!pointers.has(e.pointerId)) return;
          pointers.delete(e.pointerId);
          if (pointers.size < 2) pinchDist = 0;
          if (pointers.size === 0 && scale === MIN && moved && items.length > 1) {
            const dx = e.clientX - downX;
            if (Math.abs(dx) > 50) show(idx + (dx < 0 ? 1 : -1));
          }
        }

        stage.addEventListener('pointerup', endPointer);
        stage.addEventListener('pointercancel', endPointer);

        stage.addEventListener('click', function (e) {
          // A drag or swipe already handled this gesture.
          if (moved) {
            moved = false;
            return;
          }
          // Pointer capture can retarget the click, so hit-test by geometry.
          const r = el.getBoundingClientRect();
          const inside = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
          if (!inside) close();
          else zoomAt(e.clientX, e.clientY, scale > MIN ? MIN : DOUBLE);
        });
      })();
    </script>
  </>
)}
