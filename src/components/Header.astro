---
import Icon from './Icon.astro';

const pathname = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Projects' },
  { href: '/resume/', label: 'Resume' },
  { href: '/posts/', label: 'Posts' },
];

// `as const` so `icon` stays a literal union that Icon's props accept.
const socialLinks = [
  { href: 'https://github.com/gmjosack', label: 'GitHub', icon: 'github' },
  { href: 'https://madebygare.itch.io/', label: 'itch.io', icon: 'itchio' },
  { href: 'https://store.steampowered.com/developer/madebygare', label: 'Steam', icon: 'steam' },
  { href: 'https://bsky.app/profile/madebygare.bsky.social', label: 'Bluesky', icon: 'bluesky' },
  { href: 'http://discord.gg/xsq2Fy2qRT', label: 'Discord', icon: 'discord' },
] as const;
---

<header class="border-b border-bg-tertiary">
  <div class="mx-auto max-w-6xl px-4 py-4 flex items-center justify-center sm:justify-between flex-wrap gap-y-3">
    <a href="/" class="flex items-center gap-3 group">
      <img
        src="/images/logos/black-bg-icon.png"
        alt="Made By Gare"
        class="h-10 rounded"
      />
      <span class="section-title text-text-primary text-xl group-hover:text-accent transition-colors">
        Made By Gare
      </span>
    </a>

    <div class="flex items-center gap-6 flex-wrap gap-y-3 w-full sm:w-auto justify-center sm:justify-end">
      <nav class="hidden sm:flex items-center gap-6">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'label text-xs transition-colors',
              pathname === href
                ? 'text-accent'
                : 'text-text-secondary hover:text-text-primary',
            ]}
          >
            {label}
          </a>
        ))}
      </nav>

      <div class="w-px h-5 bg-bg-tertiary hidden sm:block" />

      <div class="flex items-center gap-4">
        {socialLinks.map(({ href, label, icon }) => (
        <a
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          title={label}
          aria-label={label}
          class="text-text-secondary hover:text-accent transition-colors"
        >
          <Icon name={icon} />
        </a>
      ))}
      </div>
    </div>
  </div>

  <nav class="sm:hidden flex border-t border-bg-tertiary">
    {navLinks.map(({ href, label }) => (
      <a
        href={href}
        class:list={[
          'label flex-1 text-center text-xs py-2.5 transition-colors border-r border-bg-tertiary last:border-r-0',
          pathname === href
            ? 'text-accent bg-accent/10'
            : 'text-text-secondary hover:text-text-primary hover:bg-bg-secondary',
        ]}
      >
        {label}
      </a>
    ))}
  </nav>
</header>
