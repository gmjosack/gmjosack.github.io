---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  twitterCard?: "summary" | "summary_large_image";
  ogType?: string;
  noindex?: boolean;
}

const { title, description, image, imageAlt, twitterCard, ogType, noindex } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-bg-primary text-text-primary">
  <head>
    <BaseHead
      title={title}
      description={description}
      image={image}
      imageAlt={imageAlt}
      twitterCard={twitterCard}
      ogType={ogType}
      noindex={noindex}
    />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main class="flex-1 mx-auto max-w-6xl w-full px-4 py-8">
      <slot />
    </main>
    <Footer />
  </body>
</html>
